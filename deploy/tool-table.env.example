# /etc/tool-table/tool-table.env — written by scripts/tool-table.sh install
# Edit, then: sudo bash /opt/tool-table/scripts/tool-table.sh install   (re-renders nginx/systemd)

# --- App (read by the service) ---
TOOL_TABLE_DATA_DIR=/var/lib/tool-table
TOOL_TABLE_ICON_DIR=/var/lib/tool-table/icons
TOOL_TABLE_ENABLE_DOCS=false

# --- Ports ---
# App listens on 127.0.0.1 only (never exposed)
TOOL_TABLE_APP_PORT=8080
# Public HTTPS port served by nginx
TOOL_TABLE_HTTPS_PORT=33443
# Plain HTTP port that only redirects to HTTPS (0 = do not listen)
TOOL_TABLE_HTTP_PORT=80

# --- Name used for nginx server_name and the self-signed certificate (empty = any) ---
TOOL_TABLE_FQDN=

# --- Backups ---
TOOL_TABLE_BACKUP_DIR=/var/backups/tool-table
TOOL_TABLE_BACKUP_KEEP_DAYS=14

# --- Accounts (server edition) ---
# Sign-in for the whole site (except the public progress dashboard /dashboard).
# The installer creates the local break-glass admin "localadmin" and prints its password once
# (also in /etc/tool-table/initial-admin.txt). New password: tool-table.sh reset-admin
TOOL_TABLE_AUTH=true
#TOOL_TABLE_SESSION_HOURS=12
#TOOL_TABLE_LOCAL_ADMIN=localadmin

# --- Active Directory (LDAP) ---
# After editing: sudo systemctl restart tool-table && sudo bash /opt/tool-table/scripts/tool-table.sh ldap-check
# ldaps:// (636) is recommended; plain ldap:// (389) sends passwords unencrypted unless STARTTLS=true.
#TOOL_TABLE_LDAP_URL=ldaps://dc1.corp.local
#TOOL_TABLE_LDAP_BASE_DN=DC=corp,DC=local
# Option A (recommended): read-only service account — also enables @mention / assign search of the directory
#TOOL_TABLE_LDAP_BIND_DN=CN=svc-tooltable,OU=Service Accounts,DC=corp,DC=local
#TOOL_TABLE_LDAP_BIND_PASSWORD=
# Option B: no service account — users bind as account@domain (UPN)
#TOOL_TABLE_LDAP_DOMAIN=corp.local
# Only let these accounts in (optional LDAP filter), e.g. members of one group:
#TOOL_TABLE_LDAP_USER_FILTER=(memberOf=CN=ToolTable-Users,OU=Groups,DC=corp,DC=local)
# TLS: verify the DC certificate (default true); internal CA bundle if needed
#TOOL_TABLE_LDAP_TLS_VERIFY=true
#TOOL_TABLE_LDAP_CA_FILE=/etc/tool-table/ad-ca.pem
#TOOL_TABLE_LDAP_STARTTLS=false
# Attribute names (Active Directory defaults)
#TOOL_TABLE_LDAP_LOGIN_ATTR=sAMAccountName
#TOOL_TABLE_LDAP_NAME_ATTR=displayName
#TOOL_TABLE_LDAP_DEPT_ATTR=department
#TOOL_TABLE_LDAP_MAIL_ATTR=mail
