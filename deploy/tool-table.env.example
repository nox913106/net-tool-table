# /etc/tool-table/tool-table.env — written by scripts/tool-table.sh install
# Edit, then: sudo bash /opt/tool-table/scripts/tool-table.sh install   (re-renders nginx/systemd)

# --- App (read by the service) ---
TOOL_TABLE_DATA_DIR=/var/lib/tool-table
TOOL_TABLE_ICON_DIR=/var/lib/tool-table/icons
# API 文件（Swagger UI，/docs）：admin＝僅管理員（預設）、on＝所有登入的人、off＝關閉
TOOL_TABLE_API_DOCS=admin

# --- Ports ---
# App listens on 127.0.0.1 only (never exposed)
TOOL_TABLE_APP_PORT=8080
# Public HTTPS port served by nginx
TOOL_TABLE_HTTPS_PORT=443
# Plain HTTP port that only redirects to HTTPS (0 = do not listen)
TOOL_TABLE_HTTP_PORT=80

# --- Name used for nginx server_name and the self-signed certificate (empty = any) ---
TOOL_TABLE_FQDN=

# --- Backups ---
TOOL_TABLE_BACKUP_DIR=/var/backups/tool-table
TOOL_TABLE_BACKUP_KEEP_DAYS=14

# --- Accounts (server edition) ---
# Sign-in for the whole site (except the public progress dashboard /dashboard).
# Everything else — AD / LDAP sign-in, session and lockout, HTTPS certificate, ports, backups —
# is set in the admin UI (後台 → 系統設定 / 備份與匯入). Nothing here needs editing.
TOOL_TABLE_AUTH=true

# --- Windows client updates ---
# Linked standalone copies update themselves from this server (/api/sync/package). When an update needs
# new Python packages they are asked to run the full installer instead; its address (default: GitHub Releases):
# TOOL_TABLE_CLIENT_INSTALLER_URL=https://files.corp.local/IPMS-Setup.exe
